# Copy to .env and set your password. The .env file is excluded from Git.
PG_PASSWORD=choose_a_password
# Sync times (Europe/Moscow)
RUN_TIMES=09:00,22:00
# History start date (YYYY-MM-DD). Empty = the last BACKFILL_DAYS_DEFAULT days
BACKFILL_FROM=
BACKFILL_DAYS_DEFAULT=90
# Number of recent days to reload on each run
RESYNC_DAYS=3
# Google Drive folder for rclone
RCLONE_REMOTE=gdrive:
# Download original activity FIT files (1 = yes, 0 = no)
DOWNLOAD_FIT=1
