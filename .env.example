# Скопируй в .env и впиши пароль. Сам .env в репозиторий не попадает.
PG_PASSWORD=придумай_пароль
# Время сбора (Europe/Moscow)
RUN_TIMES=09:00,22:00
# С какой даты догрузить историю (ГГГГ-ММ-ДД). Пусто = последние BACKFILL_DAYS_DEFAULT дней
BACKFILL_FROM=
BACKFILL_DAYS_DEFAULT=90
# Сколько последних дней перечитывать при каждом проходе
RESYNC_DAYS=3
# Папка Google Drive для rclone
RCLONE_REMOTE=gdrive:
# Скачивать исходные FIT-файлы тренировок (1 — да, 0 — нет)
DOWNLOAD_FIT=1
